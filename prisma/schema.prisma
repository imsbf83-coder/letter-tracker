// Letter/File Tracking System — database schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A school that sends/receives letters
model School {
  id        String   @id @default(cuid())
  name      String
  code      String?  @unique
  contact   String?
  createdAt DateTime @default(now())

  letters Letter[]
}

// A "desk" — a designation/seat that a letter can be marked to.
// A user can belong to more than one desk (e.g. covering two roles),
// so this is a many-to-many relation rather than one desk per user.
model Desk {
  id        String   @id @default(cuid())
  title     String   @unique // e.g. "Section Officer (Admin)"
  createdAt DateTime @default(now())

  users            User[]
  letters          Letter[]        @relation("CurrentDesk")
  initialFor       Letter[]        @relation("InitialDesk")
  movementsFrom    Movement[]      @relation("FromDesk")
  movementsTo      Movement[]      @relation("ToDesk")
}

enum Role {
  ADMIN // manages schools/desks/users, sees everything
  DESK // normal user, tied to one or more desks
}

model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  passwordHash String
  role         Role     @default(DESK)
  desks        Desk[] // a DESK-role user can hold more than one desk
  createdAt    DateTime @default(now())

  letters                   Letter[]           @relation("CreatedBy")
  movements                 Movement[]         @relation("MovedBy")
  retrievalRequestsMade     RetrievalRequest[] @relation("RetrievalRequestedBy")
  retrievalRequestsDecided  RetrievalRequest[] @relation("RetrievalDecidedBy")
}

enum LetterStatus {
  PENDING
  CLOSED
}

model Letter {
  id             String       @id @default(cuid())
  diaryNo        String // your office's own receiving/register number
  senderLetterNo String? // the letter no. already printed on the incoming letter, if any
  dateReceived   DateTime
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id])
  receivedFrom   String // name/designation of the person at the school
  subject        String
  initialDeskId  String
  initialDesk    Desk         @relation("InitialDesk", fields: [initialDeskId], references: [id])
  currentDeskId  String
  currentDesk    Desk         @relation("CurrentDesk", fields: [currentDeskId], references: [id])
  status         LetterStatus @default(PENDING)
  createdById    String
  createdBy      User         @relation("CreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime     @default(now())
  closedAt       DateTime?

  movements         Movement[]
  retrievalRequests RetrievalRequest[]

  @@index([schoolId])
  @@index([currentDeskId])
  @@index([status])
}

enum MovementAction {
  FORWARD
  CLOSE
  REOPENED // an admin approved a retrieval request, reopening a closed letter
}

enum DisposalType {
  REPLIED // a reply was sent back to the school
  FORWARDED_EXTERNAL // matter forwarded to another department/office (inside or outside this office's setup)
  CLOSED_NO_REPLY // closed after discussion, no written reply/forward needed
  ACTION_TAKEN // some other action was taken, described in remarks
  OTHER
}

model Movement {
  id           String         @id @default(cuid())
  letterId     String
  letter       Letter         @relation(fields: [letterId], references: [id])
  fromDeskId   String
  fromDesk     Desk           @relation("FromDesk", fields: [fromDeskId], references: [id])
  toDeskId     String? // null when action is CLOSE or REOPENED
  toDesk       Desk?          @relation("ToDesk", fields: [toDeskId], references: [id])
  action       MovementAction
  disposalType DisposalType? // only set when action is CLOSE — what happened to the letter
  letterNo     String? // outgoing/dispatch letter no., if one was issued at this step
  sentTo       String? // external office/person the reply was sent to, if closed externally
  remarks      String?
  movedById    String
  movedBy      User           @relation("MovedBy", fields: [movedById], references: [id])
  createdAt    DateTime       @default(now())

  @@index([letterId])
}

enum RetrievalStatus {
  PENDING
  APPROVED
  REJECTED
}

// A desk user's request to reopen a letter they closed by mistake (or
// before the final step was actually done). Requires an admin's approval.
model RetrievalRequest {
  id            String          @id @default(cuid())
  letterId      String
  letter        Letter          @relation(fields: [letterId], references: [id])
  requestedById String
  requestedBy   User            @relation("RetrievalRequestedBy", fields: [requestedById], references: [id])
  reason        String?
  status        RetrievalStatus @default(PENDING)
  decidedById   String?
  decidedBy     User?           @relation("RetrievalDecidedBy", fields: [decidedById], references: [id])
  decidedAt     DateTime?
  createdAt     DateTime        @default(now())

  @@index([letterId])
  @@index([status])
}
