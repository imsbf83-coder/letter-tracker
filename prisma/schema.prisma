model Letter {
  id           String           @id @default(cuid())
  letterNo     String           // Official Letter Reference / Tracking No.
  subject      String
  description  String?
  schoolId     String
  school       School           @relation(fields: [schoolId], references: [id])
  currentDeskId String
  currentDesk  Desk             @relation("CurrentDesk", fields: [currentDeskId], references: [id])
  status       LetterStatus     @default(PENDING)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  
  // Historical trail of all movements
  trails       LetterTrail[]
}

model LetterTrail {
  id           String       @id @default(cuid())
  letterId     String
  letter       Letter       @relation(fields: [letterId], references: [id], onDelete: Cascade)
  fromDeskId   String?
  fromDesk     Desk?        @relation("SentTrails", fields: [fromDeskId], references: [id])
  toDeskId     String
  toDesk       Desk         @relation("ReceivedTrails", fields: [toDeskId], references: [id])
  actionByUserId String
  actionByUser User         @relation(fields: [actionByUserId], references: [id])
  dispatchNo   String?      // Outward/Inward Letter No. for this movement step
  remarks      String?
  timestamp    DateTime     @default(now())
}

enum LetterStatus {
  PENDING
  IN_TRANSIT
  RESOLVED
  RETURNED
}