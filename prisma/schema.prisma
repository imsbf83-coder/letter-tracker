// Letter/File Tracking System — database schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A school that sends/receives letters
model School {
  id        String   @id @default(cuid())
  name      String
  code      String?  @unique
  contact   String?
  createdAt DateTime @default(now())

  letters Letter[]
}

// A "desk" — a designation/seat that a letter can be marked to.
// Users are assigned to a desk. Desks are what the office actually tracks
// movement between (not individual people), matching how e-office works.
model Desk {
  id        String   @id @default(cuid())
  title     String   @unique // e.g. "Section Officer (Admin)"
  createdAt DateTime @default(now())

  users            User[]
  letters          Letter[]        @relation("CurrentDesk")
  initialFor       Letter[]        @relation("InitialDesk")
  movementsFrom    Movement[]      @relation("FromDesk")
  movementsTo      Movement[]      @relation("ToDesk")
}

enum Role {
  ADMIN // manages schools/desks/users, sees everything
  DESK // normal user tied to one desk
}

model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  passwordHash String
  role         Role     @default(DESK)
  deskId       String?
  desk         Desk?    @relation(fields: [deskId], references: [id])
  createdAt    DateTime @default(now())

  letters   Letter[]   @relation("CreatedBy")
  movements Movement[] @relation("MovedBy")
}

enum LetterStatus {
  PENDING
  CLOSED
}

model Letter {
  id             String       @id @default(cuid())
  diaryNo        String // your office's own receiving/register number
  senderLetterNo String? // the letter no. already printed on the incoming letter, if any
  dateReceived   DateTime
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id])
  receivedFrom   String // name/designation of the person at the school
  subject        String
  initialDeskId  String
  initialDesk    Desk         @relation("InitialDesk", fields: [initialDeskId], references: [id])
  currentDeskId  String
  currentDesk    Desk         @relation("CurrentDesk", fields: [currentDeskId], references: [id])
  status         LetterStatus @default(PENDING)
  createdById    String
  createdBy      User         @relation("CreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime     @default(now())
  closedAt       DateTime?

  movements Movement[]

  @@index([schoolId])
  @@index([currentDeskId])
  @@index([status])
}

enum MovementAction {
  FORWARD
  CLOSE
}

enum DisposalType {
  REPLIED // a reply was sent back to the school
  FORWARDED_EXTERNAL // matter forwarded to another department/office (inside or outside this office's setup)
  CLOSED_NO_REPLY // closed after discussion, no written reply/forward needed
  ACTION_TAKEN // some other action was taken, described in remarks
  OTHER
}

model Movement {
  id           String         @id @default(cuid())
  letterId     String
  letter       Letter         @relation(fields: [letterId], references: [id])
  fromDeskId   String
  fromDesk     Desk           @relation("FromDesk", fields: [fromDeskId], references: [id])
  toDeskId     String? // null when action is CLOSE
  toDesk       Desk?          @relation("ToDesk", fields: [toDeskId], references: [id])
  action       MovementAction
  disposalType DisposalType? // only set when action is CLOSE — what happened to the letter
  letterNo     String? // outgoing/dispatch letter no., if one was issued at this step
  sentTo       String? // external office/person the reply was sent to, if closed externally
  remarks      String?
  movedById    String
  movedBy      User           @relation("MovedBy", fields: [movedById], references: [id])
  createdAt    DateTime       @default(now())

  @@index([letterId])
}
